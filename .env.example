# LLM (OpenAI-compatible endpoint)
# Note: the old yunwu.ai host was retired; accounts and keys moved to
# api.openlux.ai, so a key issued on the old site returns 403 / invalid token.
LLM_BASE_URL=https://api.openlux.ai/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Local textbook retrieval
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_MODEL_DIR=data/models/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_MAX_CONTEXT_CHARS=4500
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=mit_calculus

# Optional. The Vite app proxies /api to 127.0.0.1:8000 by default.
BACKEND_URL=http://127.0.0.1:8000

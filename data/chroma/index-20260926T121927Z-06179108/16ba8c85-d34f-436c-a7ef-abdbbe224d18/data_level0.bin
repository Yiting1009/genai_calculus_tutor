  {
    "id": "mit-5-6-rule-integral-properties",
    "section_id": "mit-5-6-properties-of-the-integral-and-average-value",
    "content_type": "concept",
    "subtype": "rule",
    "heading": "Properties of the integral",
    "order": 10,
    "pdf_page": 32,
    "printed_page": 260,
    "text": "The integral is linear and respects order: constants factor out, sums split apart, and a larger integrand gives a larger integral over the same interval.",
    "formulas": [
      "integral (a f + b g) = a integral f + b integral g",
      "if f <= g then integral f <= integral g"
    ],
    "figure_ids": [],
    "knowledge_points": [
      "linearity",
      "monotonicity",
      "integral properties"
    ]
  },
  {
    "id": "mit-5-6-definition-average-value",
    "section_id": "mit-5-6-properties-of-the-integral-and-average-value",
    "content_type": "concept",
    "subtype": "definition",
    "heading": "Average value of a function",
    "order": 20,
    "pdf_page": 33,
    "printed_page": 261,
    "text": "The average value of a function on an interval is its integral divided by the length of the interval. The Mean Value Theorem for integrals says the function actually attains this average somewhere.",
    "formulas": [
      "average = (1/(b - a)) integral_a^b f(x) dx",
      "f(c) = average for some c in (a, b)"
    ],
    "figure_ids": [],
    "knowledge_points": [
      "average value",
      "mean value theorem for integrals"
    ]
  },
  {
    "id": "mit-5-6-example-average-value",
    "section_id": "mit-5-6-properties-of-the-integral-and-average-value",
